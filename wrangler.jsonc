{
	"name": "lettery-blog",
	"compatibility_date": "2026-09-30",
	"compatibility_flags": [
		"nodejs_compat"
	],
	"assets": {
		"directory": "./dist"
	},
  	"observability": {
  	  	"logs": {
  	  	  	"enabled": true,
  	  	  	"head_sampling_rate": 1,
  	  	  	"invocation_logs": true,
  	  	  	"persist": true
  	  	},
  	  	"traces": {
  	  	  	"enabled": false,
  	  	  	"head_sampling_rate": 1,
  	  	  	"persist": true
  	  	}
  	}
}
